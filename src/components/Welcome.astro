---
import { shortcuts } from "../data.ts";
const platforms = Object.keys(shortcuts);
const platform = platforms[0];
---

<div id="container">
  <main>
    <section id="hero">
      <section class="pills">
        {
          Object.keys(shortcuts).map((platform, i) => (
            <button
              class="pill"
              data-platform={platform}
              role="tab"
              aria-selected={i === 0}
              tabindex={i === 0 ? "0" : "-1"}
            >
              {platform}
            </button>
          ))
        }
      </section>
      <h2 class="subtitle">{platform}</h2>

      <section id="shortcuts">
        {
          Object.entries(shortcuts[platform]).map(([name, shortcut], index) => (
            <div class="shortcut" data-platform={platform}>
              <div class="chord-group">
                <div class="chord">
                  {Object.entries(shortcut.keys).map(([index, key]) => (
                    <div class="keycap">{key}</div>
                  ))}
                </div>
                <div class="chord-description">{name}</div>
              </div>
            </div>
          ))
        }
      </section>
    </section>
  </main>
</div>

<style is:global>
  [hidden] {
    display: none !important;
  }
  #container {
    font-family:
      Inter, Roboto, "Helvetica Neue", "Arial Nova", "Nimbus Sans", Arial,
      sans-serif;
    height: 100%;
  }

  main {
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #hero {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    width: 50%;
    height: 50%;
    flex-direction: column;
    padding: 16px;
    background: #9ca3af;
  }

  .pills {
    display: flex;
    gap: 8px;
    margin-bottom: 16px;
    max-width: 90%;
    overflow-y: scroll;
    min-height: 48px;
  }

  .pill {
    border-radius: 4px;
    background-color: #bdc0c8;
    padding: 4px 8px;
    font-size: 14px;
  }

  [aria-selected="true"] {
    background-color: #111827;
    color: white;
  }

  .pill:hover {
    background-color: #9ca3af;
  }

  h2 {
    margin: 0 0 1em;
    font-weight: normal;
    color: #111827;
    font-size: 20px;
  }

  #shortcuts {
    display: flex;
    flex-direction: column;
    gap: 16px;
    overflow: scroll;
  }

  .shortcut {
    display: flex;
    gap: 4px;
  }

  .shortcut:hover {
    background-color: #f3f4f6;
    border-radius: 4px;
  }

  .chord-group {
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .chord {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 14px;
  }

  .keycap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    padding: 2px 6px;
    border-radius: 4px;
    background-color: #e5e7eb;
    font-size: 12px;
    margin-right: 5px;
  }

  .keycap + .keycap::before {
    content: "+";
    display: inline-block;
    margin: 0 8px 0 -16px;
    color: #6b7280;
    font-size: 12px;
    background: transparent;
  }

  @media screen and (max-width: 768px) {
    .chord {
      gap: 6px;
    }

    .keycap + .keycap::before {
      margin: 0 6px;
    }

    .pills {
      min-height: 48px;
    }

    #hero {
      width: 100%;
      padding: 10px;
    }
  }

  @media screen and (max-width: 768px) {
    #container {
      display: flex;
      flex-direction: column;
    }
  }
</style>

<script>
  import { shortcuts } from "../data";

  let currentPlatform = `{platform}`;
  const platforms = Object.keys(shortcuts);
  const filterKeys: string[] = [];

  const pills = document.querySelectorAll<HTMLElement>(".pill");
  const shortcutsList = document.getElementById("shortcuts")!;
  const subtitle = document.querySelector(".subtitle")!;

  document.body.addEventListener("keydown", (e) => {
    if (e.key === "ArrowRight") {
      const currentIndex = platforms.indexOf(currentPlatform);
      const nextIndex = (currentIndex + 1) % platforms.length;
      const nextPlatform = platforms[nextIndex];
      const nextPill = document.querySelector<HTMLElement>(
        `.pill[data-platform="${nextPlatform}"]`,
      )!;
      nextPill.click();
    } else if (e.key === "ArrowLeft") {
      const currentIndex = platforms.indexOf(currentPlatform);
      const prevIndex =
        (currentIndex - 1 + platforms.length) % platforms.length;
      const prevPlatform = platforms[prevIndex];
      const prevPill = document.querySelector<HTMLElement>(
        `.pill[data-platform="${prevPlatform}"]`,
      )!;
      prevPill.click();
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.repeat) return; // Ignore held-down keys
    if (e.key === "Tab" || e.key === "ArrowRight" || e.key === "ArrowLeft")
      return; // Ignore navigation keys
    filterKeys.push(e.key.toLowerCase());
    renderShortcuts(currentPlatform, filterKeys);
  });

  document.addEventListener("keyup", (e) => {
    const index = filterKeys.indexOf(e.key.toLowerCase());
    if (index > -1) {
      console.log("removing key:", e.key.toLowerCase());
      filterKeys.splice(index, 1);
      renderShortcuts(currentPlatform, filterKeys);
    }
  });

  function renderShortcuts(platform: string, filters: string[] = []) {
    let platformShortcuts = shortcuts[platform];
    console.log("current shortcuts:", platformShortcuts);
    console.log({ filterKeys });

    if (filters.length > 0) {
      platformShortcuts = platformShortcuts.filter((shortcut) =>
        Object.values(shortcut.keys).some((key) =>
          filters.includes(key.toLowerCase()),
        ),
      );
    }

    shortcutsList.innerHTML = platformShortcuts
      .map(
        (shortcut) => `
  			<div class="shortcut">
              <div class="chord-group">
                <div class="chord">
                  ${Object.entries(shortcut.keys)
                    .map(
                      ([index, key]) => `
                    <div class="keycap">${key}</div>
                  `,
                    )
                    .join("")}
                </div>
                <div class="chord-description">${shortcut.action}</div>
              </div>
            </div>
`,
      )
      .join("");
  }

  pills.forEach((pill, index) => {
    pill.addEventListener("click", () => {
      const platform = pill.dataset.platform;
      // Update pill selection
      pills.forEach((p) => p.setAttribute("aria-selected", "false"));
      pill.setAttribute("aria-selected", "true");

      if (platform) {
        currentPlatform = platform;
        renderShortcuts(platform, filterKeys);
        subtitle.textContent = platform;
      }
    });
  });
</script>
